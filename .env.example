# ---- Zero-cost provider pool (fill only what you have) ----
# Google AI Studio free tier
TEAMCLAW_GEMINI_API_KEY=
# Zhipu GLM (glm-4-flash is free)
TEAMCLAW_GLM_API_KEY=
# Groq free tier
TEAMCLAW_GROQ_API_KEY=
# Cerebras free tier
TEAMCLAW_CEREBRAS_API_KEY=
# SiliconFlow (has :free models)
TEAMCLAW_SILICONFLOW_API_KEY=
# Optional paid, ONLY used by the `strong-naked` ablation arm
TEAMCLAW_STRONG_API_KEY=
TEAMCLAW_STRONG_BASE_URL=
TEAMCLAW_STRONG_MODEL=

# ---- Local inference (Ollama) ----
TEAMCLAW_OLLAMA_BASE_URL=http://localhost:11434

# ---- SEC requires a self-identifying UA, see https://www.sec.gov/os/webmaster-faq ----
TEAMCLAW_SEC_USER_AGENT=TeamClaw Research your.email@example.com

# ---- Safety: never let an ablation arm silently spend money ----
TEAMCLAW_ALLOW_PAID=0
