# ---- Zero-cost provider pool (fill only what you have) ----
# Google AI Studio free tier
TALLY_GEMINI_API_KEY=
# Zhipu GLM (glm-4-flash is free)
TALLY_GLM_API_KEY=
# Groq free tier
TALLY_GROQ_API_KEY=
# Cerebras free tier
TALLY_CEREBRAS_API_KEY=
# SiliconFlow (has :free models)
TALLY_SILICONFLOW_API_KEY=
# Optional paid, ONLY used by the `strong-naked` ablation arm
TALLY_STRONG_API_KEY=
TALLY_STRONG_BASE_URL=
TALLY_STRONG_MODEL=

# ---- Local inference (Ollama) ----
TALLY_OLLAMA_BASE_URL=http://localhost:11434

# ---- SEC requires a self-identifying UA, see https://www.sec.gov/os/webmaster-faq ----
TALLY_SEC_USER_AGENT=Tally Research your.email@example.com

# ---- Safety: never let an ablation arm silently spend money ----
TALLY_ALLOW_PAID=0

# ---- Serving layer ----
# Session state. Omit and it falls back to process memory, which is correct for
# one worker and silently wrong for more than one.
TALLY_REDIS_URL=
# Required if you bind beyond localhost: this server executes generated code.
TALLY_API_TOKEN=
TALLY_API_HOST=127.0.0.1
TALLY_API_PORT=8000
TALLY_API_WORKERS=1

# ---- Channels (optional) ----
TALLY_FEISHU_APP_ID=
TALLY_FEISHU_APP_SECRET=
TALLY_FEISHU_VERIFICATION_TOKEN=
TALLY_FEISHU_ENCRYPT_KEY=
TALLY_SLACK_SIGNING_SECRET=
TALLY_SLACK_BOT_TOKEN=
